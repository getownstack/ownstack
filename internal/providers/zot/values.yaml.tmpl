service:
  type: ClusterIP
  port: 5000
ingress:
  enabled: true
  className: traefik
  pathtype: Prefix
  annotations:
{{- range $key, $value := .Annotations }}
    {{ $key }}: {{ printf "%q" $value }}
{{- end }}
  hosts:
    - host: {{ .Host }}
      paths:
        - path: /
persistence: true
pvc:
  create: true
  storage: {{ .StorageGiB }}Gi
mountConfig: true
configFiles:
  config.json: |-
    {
{{- if gt .KeepTags 0 }}
      "storage": {
        "rootDirectory": "/var/lib/registry",
        "gc": true,
        "retention": {
          "policies": [
            {
              "repositories": ["**"],
              "deleteUntagged": true,
              "keepTags": [{ "mostRecentlyPushedCount": {{ .KeepTags }}, "pulledWithin": "720h" }]
            }
          ]
        }
      },
{{- else }}
      "storage": { "rootDirectory": "/var/lib/registry", "gc": true },
{{- end }}
      "http": {
        "address": "0.0.0.0",
        "port": "5000",
        "realm": "ownstack",
        "compat": ["docker2s2"],
        "auth": { "htpasswd": { "path": "/secret/htpasswd" } }
      },
      "log": { "level": "info" }
    }
mountSecret: true
secretFiles:
  htpasswd: {{ printf "%q" .Htpasswd }}
