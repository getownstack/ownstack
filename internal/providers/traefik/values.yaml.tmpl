ingressRoute:
  dashboard:
    enabled: true
    matchRule: Host(`{{ .DashboardHost }}`)
    entryPoints:
      - {{ .EntryPoint }}
    tls:
      certResolver: {{ .CertResolver }}
providers:
  kubernetesGateway:
    enabled: true
gateway:
  namespacePolicy: All
certificatesResolvers:
  {{ .CertResolver }}:
    acme:
      email: {{ printf "%q" .Email }}
      storage: /data/acme.json
{{- if .Staging }}
      caServer: {{ .StagingURL }}
{{- end }}
      dnsChallenge:
        provider: {{ .DNSProvider }}
        # Give the DNS provider time to publish the TXT record before Let's
        # Encrypt looks; without it new hosts can fail validation.
        propagation:
          delayBeforeChecks: 30s
        resolvers:
          - 1.1.1.1:53
          - 8.8.8.8:53
{{- if .EnvNames }}
env:
{{- range .EnvNames }}
  - name: {{ . }}
    valueFrom:
      secretKeyRef:
        name: {{ $.SecretName }}
        key: {{ . }}
{{- end }}
{{- end }}
# acme.json must stay 0600 or Traefik refuses to use stored certificates.
deployment:
  initContainers:
    - name: acme-permissions
      image: busybox:1.37
      command: ["sh", "-c", "touch /data/acme.json && chmod 600 /data/acme.json"]
      volumeMounts:
        - name: data
          mountPath: /data
persistence:
  enabled: true
  path: /data
  accessMode: ReadWriteOnce
  size: 1Gi
ports:
  web:
    redirections:
      entryPoint:
        to: websecure
        scheme: https
