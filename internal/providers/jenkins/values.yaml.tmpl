controller:
  image:
    # The Jenkins core plugins.lock is verified for, whatever the chart's default.
    tag: {{ printf "%q" .ImageTag }}
  ingress:
    enabled: true
    hostName: {{ .Host }}
    annotations:
{{- range $key, $value := .Annotations }}
      {{ $key }}: {{ printf "%q" $value }}
{{- end }}
  admin:
    username: admin
    password: {{ printf "%q" .Password }}
    createSecret: true
  jenkinsUrl: https://{{ .Host }}
  # Every plugin at its locked version (plugins.lock plus extraPlugins), and
  # nothing newer: dependencies are all listed.
  installPlugins:
{{- range .Plugins }}
    - {{ printf "%q" . }}
{{- end }}
  installLatestPlugins: false
  installLatestSpecifiedPlugins: false
  # Reinstall exactly this set on every start, so upgrades and removals take
  # effect and plugins installed outside it do not linger.
  overwritePlugins: true
  JCasC:
    enabled: true
    configScripts:
      main: |-
        jenkins:
          globalNodeProperties:
          - envVars:
              env:
{{- range .GlobalEnv }}
              - key: {{ .Key }}
                value: {{ printf "%q" .Value }}
{{- end }}
          clouds:
          - kubernetes:
              containerCap: 10
              name: "kubernetes-cluster"
              webSocket: true
        unclassified:
          globalLibraries:
            libraries:
              - defaultVersion: "main"
                implicit: true
                name: "jenkins_pipeline_library"
                retriever:
                  modernSCM:
                    libraryPath: "jenkins_pipeline_library/"
                    scm:
                      git:
                        credentialsId: "{{ .VCSCredentialID }}"
                        remote: {{ printf "%q" .ClusterRepoURL }}
                        traits:
                          - "gitBranchDiscovery"
{{- if .Slack }}
          slackNotifier:
            botUser: true
            teamDomain: ""
            tokenCredentialId: "{{ .AlertsCredentialID }}"
            room: {{ printf "%q" .Slack.Channel }}
{{- end }}
        security:
          gitHostKeyVerificationConfiguration:
            sshHostKeyVerificationStrategy: acceptFirstConnectionStrategy
